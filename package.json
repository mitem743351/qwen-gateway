{
  "name": "qwen-gateway",
  "version": "0.1.0",
  "description": "Self-hosted gateway exposing chat.qwen.ai capabilities through an OpenAI-compatible API",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:cloak": "tsx scripts/check-cloakbrowser.ts",
    "probe": "tsx scripts/probe-protocol.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "better-sqlite3": "^11.8.1",
    "cloakbrowser": "^0.5.9",
    "dotenv": "^16.4.7",
    "hono": "^4.7.2",
    "playwright-core": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
