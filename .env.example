# Project Qwen Gateway Configuration (.env.example)

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
DEFAULT_MODEL=qwen3.7-plus

# Gateway local API protection (comma-separated or empty for open local access)
API_KEYS=

# Accounts and browser profile storage
ACCOUNTS_DIR=./data/profiles
DB_PATH=./data/gateway.sqlite

# Upstream target and operational modes
QWEN_BASE_URL=https://chat.qwen.ai
GUEST_MODE=false
ALLOW_UNKNOWN_MODELS=false
QWEN_TRANSPORT=live

# Browser configuration
HEADLESS=true
PROXY=
BROWSER_LAUNCH_TIMEOUT_MS=30000

# CloakBrowser binary override & license
CLOAKBROWSER_BINARY_PATH=
CLOAKBROWSER_LICENSE_KEY=

# Request-level retry budget overrides (plan §4.9)
MAX_RETRY_ATTEMPTS=4
MAX_ACCOUNT_ROTATIONS=2
MAX_BROWSER_FALLBACKS=1
MAX_RETRY_DURATION_SEC=60
